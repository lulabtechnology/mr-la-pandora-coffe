---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ContactLinks from './ContactLinks.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { content, type Locale } from '../data/content';
import { business, visitPaths } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const mapUrl = business.mapUrl;
const instagramUrl = business.instagram;
---
<BaseLayout locale={locale} title={t.seoTitle} description={t.seoDescription} questions={t.questions}>
  <SiteHeader locale={locale} />
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-photo"><picture><source media="(min-width: 761px)" srcset="/images/optimized/hero-960.webp 960w, /images/optimized/hero-1440.webp 1440w, /images/optimized/hero-1920.webp 1920w" sizes="100vw" /><img src="/images/optimized/taza-640.webp" srcset="/images/optimized/taza-640.webp 640w, /images/optimized/taza-960.webp 960w" sizes="100vw" alt={t.heroImageAlt} width="1050" height="1400" fetchpriority="high" /></picture></div>
          <div class="hero-shade" aria-hidden="true"></div>
          <div class="hero-content">
            <p class="hero-overline">{t.heroEyebrow}</p>
            <div class="hero-main">
              <h1 id="hero-title"><span>{t.heroLine1}</span><em>{t.heroLine2}</em></h1>
              <div class="hero-aside"><p>{t.heroText}</p><a class="pill-link pill-light" href="#experiencia">{t.discover}<span aria-hidden="true">↘</span></a></div>
            </div>
            <div class="hero-foot"><span>LA PANDORA COFFEE / PANAMÁ</span><a href="#experiencia" aria-label={t.scroll}><span>{t.scroll}</span><span aria-hidden="true">↓</span></a></div>
          </div>
        </section>

        <div class="interlude" aria-hidden="true"><span>{t.interlude}</span><span class="interlude-mark">✳</span><span>{t.interlude}</span></div>

        <nav class="section-nav section-wrap" aria-label={t.sectionNav}>
          <a href="#experiencia">{t.navSpace}</a><a href="#historia">{t.navStory}</a><a href="#origen">{t.navOrigin}</a><a href={visitPaths[locale]}>{t.visitPage.nav}<span aria-hidden="true">↗</span></a>
        </nav>
        <section class="experience" id="experiencia" aria-labelledby="experience-title">
          <div class="section-wrap experience-intro"><div class="section-label"><span>01 / 04</span><span>{t.experienceEyebrow}</span></div><div class="experience-head"><h2 id="experience-title">{t.experienceTitle}</h2><p>{t.experienceText}</p></div></div>
          <div class="experience-gallery">
            <figure><ResponsiveImage name="interior" alt={t.experienceImageAlt} width={1350} height={2398} sizes="(max-width: 500px) 100vw, (max-width: 760px) 100vw, 33vw" /><figcaption><span>01</span>{t.caption1}</figcaption></figure>
            <figure><ResponsiveImage name="ritual" alt={t.coffeeImageAlt} width={1350} height={2398} sizes="(max-width: 500px) 100vw, (max-width: 760px) 50vw, 33vw" /><figcaption><span>02</span>{t.caption2}</figcaption></figure>
            <figure><ResponsiveImage name="espacio" alt={t.spaceImageAlt} width={1050} height={1067} sizes="(max-width: 500px) 100vw, (max-width: 760px) 50vw, 33vw" /><figcaption><span>03</span>{t.caption3}</figcaption></figure>
          </div>
          <div class="coffee-pair" aria-label={t.coffeeGalleryLabel}>
            <figure><ResponsiveImage name="vertido" alt={t.coffeePourAlt} width={1920} height={1280} sizes="(max-width: 500px) 100vw, 50vw" /><figcaption>{t.coffeePourCaption}</figcaption></figure>
            <figure><ResponsiveImage name="servido" alt={t.coffeeServeAlt} width={1920} height={1280} sizes="(max-width: 500px) 100vw, 50vw" /><figcaption>{t.coffeeServeCaption}</figcaption></figure>
          </div>
        </section>

        <section class="story" id="historia" aria-labelledby="story-title">
          <div class="section-wrap">
            <div class="section-label"><span>02 / 04</span><span>{t.storyEyebrow}</span></div>
            <div class="story-heading"><h2 id="story-title">{t.storyTitle1}<br /><em>{t.storyTitle2}</em></h2></div>
            <div class="story-grid">
              <figure class="story-art"><ResponsiveImage name="fabula" alt={t.artworkAlt} width={1161} height={1020} sizes="(max-width: 760px) 90vw, 50vw" /><figcaption>{t.artworkCaption}</figcaption></figure>
              <div class="story-copy"><p>{t.storyText}</p><span class="story-signature">La Pandora <span aria-hidden="true">✳</span></span></div>
            </div>
            <div class="founders" aria-labelledby="founders-title">
              <figure class="founders-photo"><ResponsiveImage name="socios" alt={t.foundersImageAlt} width={1920} height={1280} sizes="(max-width: 760px) 90vw, 60vw" /></figure>
              <div class="founders-copy">
                <p class="founders-eyebrow">{t.foundersEyebrow}</p>
                <h3 id="founders-title">{t.foundersTitle}</h3>
                <div class="founders-person"><strong>Mario Lozano</strong><span>{t.marioRole}</span></div>
                <div class="founders-person"><strong>Consuelo García</strong><span>{t.consueloRole}</span></div>
              </div>
            </div>
          </div>
        </section>

        <section class="origin" id="origen" aria-labelledby="origin-title">
          <div class="origin-copy"><div class="section-label"><span>03 / 04</span><span>{t.originEyebrow}</span></div><h2 id="origin-title">{t.originTitle}</h2><p>{t.originText}</p><span class="origin-note">{t.originNote}</span></div>
          <figure class="origin-visual"><ResponsiveImage name="empaque" alt={t.originImageAlt} width={1200} height={1600} sizes="(max-width: 760px) 100vw, 44vw" /></figure>
        </section>

        <section class="visit section-wrap" id="visita" aria-labelledby="visit-title">
          <div class="section-label"><span>04 / 04</span><span>{t.visitEyebrow}</span></div>
          <div class="visit-head"><h2 id="visit-title">{t.visitTitle}</h2><p>{t.visitText}</p></div>
          <div class="visit-board"><div class="visit-detail"><span>{t.location}</span><p>{t.locationValue}</p><p class="parking-note">{t.parking}</p></div><div class="visit-detail"><span>{t.hours}</span><p>{t.hours1}<br />{t.hours2}</p></div><div class="visit-detail visit-contact"><span>{t.contact}</span><ContactLinks locale={locale} /></div><div class="visit-actions"><a class="pill-link pill-dark" href={mapUrl} target="_blank" rel="noopener noreferrer">{t.maps}<span aria-hidden="true">↗</span></a><a class="under-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">{t.instagram}<span aria-hidden="true">↗</span></a></div></div>
          <p class="visit-more"><a class="under-link" href={visitPaths[locale]}>{t.visitDetails}<span aria-hidden="true">↗</span></a></p>
          <div class="questions" aria-labelledby="questions-title"><h3 id="questions-title">{t.questionsTitle}</h3><div class="question-grid">{t.questions.map(({ question, answer }) => <article class="question"><h4>{question}</h4><p>{answer}</p></article>)}</div></div>
        </section>
      </main>

  <SiteFooter locale={locale} />
</BaseLayout>
