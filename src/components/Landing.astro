---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { content, locales, type Locale } from '../data/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const paths: Record<Locale, string> = { es: '/', en: '/en/', ru: '/ru/' };
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://lapandoracoffee.com').replace(/\/$/, '');
const canonical = `${siteUrl}${paths[locale]}`;
const logoImage = `${siteUrl}/images/logo-oficial.jpg`;
const socialImage = `${siteUrl}/images/taza-pandora.webp`;
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=La+Pandora+Coffee%2C+Calle+50%2C+Panama';
const instagramUrl = 'https://www.instagram.com/lapandoracoffee/';
const homeLabel = { es: 'La Pandora Coffee, inicio', en: 'La Pandora Coffee, home', ru: 'La Pandora Coffee, главная' }[locale];
const topLabel = { es: 'Volver arriba', en: 'Back to top', ru: 'Наверх' }[locale];
const businessData = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': `${siteUrl}/#business`,
  name: 'La Pandora Coffee',
  alternateName: ['La Pandora', 'Mr La Pandora'],
  description: t.seoDescription,
  image: `${siteUrl}/images/interior-pandora.webp`,
  logo: logoImage,
  founder: [
    { '@type': 'Person', name: 'Mario Lozano' },
    { '@type': 'Person', name: 'Consuelo García' },
  ],
  url: `${siteUrl}/`,
  sameAs: [instagramUrl],
  hasMap: mapUrl,
  address: { '@type': 'PostalAddress', streetAddress: 'Calle 50', addressLocality: 'Ciudad de Panamá', addressCountry: 'PA' },
  geo: { '@type': 'GeoCoordinates', latitude: 8.991044, longitude: -79.511425 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '08:00', closes: '21:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '08:00', closes: '16:00' },
  ],
};
const pageData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: t.seoTitle,
  description: t.seoDescription,
  inLanguage: locale,
  about: { '@id': `${siteUrl}/#business` },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1512" />
    <meta name="description" content={t.seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'es' ? 'es_PA' : locale === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:site_name" content="La Pandora Coffee" />
    <meta property="og:title" content={t.seoTitle} />
    <meta property="og:description" content={t.seoDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={t.socialImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    {locales.map((lang) => <link rel="alternate" hreflang={lang} href={`${siteUrl}${paths[lang]}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="icon" type="image/jpeg" href="/images/logo-oficial.jpg" />
    {locale !== 'ru' && <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-latin-wght.woff2" crossorigin="anonymous" />}
    <link rel="preload" as="image" href="/images/hero-panorama-editorial.png" media="(min-width: 761px)" />
    <link rel="preload" as="image" href="/images/taza-pandora.webp" media="(max-width: 760px)" />
    <title>{t.seoTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify([businessData, pageData])} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header" aria-label="La Pandora Coffee">
        <span class="header-location">{t.locationValue}</span>
        <a class="brand" href={paths[locale]} aria-label={homeLabel}><img src="/images/logo-oficial.jpg" alt="La Pandora Coffee" width="723" height="723" /></a>
        <div class="header-actions">
          <div class="languages" aria-label="Language / Idioma / Язык">
            {locales.map((lang) => <a href={paths[lang]} lang={lang} hreflang={lang} aria-current={locale === lang ? 'page' : undefined}>{lang.toUpperCase()}</a>)}
          </div>
          <a class="header-visit" href="#visita">{t.visit}<span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-photo"><picture><source media="(min-width: 761px)" srcset="/images/hero-panorama-editorial.png" /><img src="/images/taza-pandora.webp" alt={t.heroImageAlt} width="1050" height="1400" fetchpriority="high" /></picture></div>
          <div class="hero-shade" aria-hidden="true"></div>
          <div class="hero-content">
            <p class="hero-overline">{t.heroEyebrow}</p>
            <div class="hero-main">
              <h1 id="hero-title"><span>{t.heroLine1}</span><em>{t.heroLine2}</em></h1>
              <div class="hero-aside"><p>{t.heroText}</p><a class="pill-link pill-light" href="#experiencia">{t.discover}<span aria-hidden="true">↘</span></a></div>
            </div>
            <div class="hero-foot"><span>LA PANDORA COFFEE / PANAMÁ</span><a href="#experiencia" aria-label={t.scroll}><span>{t.scroll}</span><span aria-hidden="true">↓</span></a></div>
          </div>
        </section>

        <div class="interlude" aria-hidden="true"><span>{t.interlude}</span><span class="interlude-mark">✳</span><span>{t.interlude}</span></div>

        <section class="experience" id="experiencia" aria-labelledby="experience-title">
          <div class="section-wrap experience-intro"><div class="section-label"><span>01 / 04</span><span>{t.experienceEyebrow}</span></div><div class="experience-head"><h2 id="experience-title">{t.experienceTitle}</h2><p>{t.experienceText}</p></div></div>
          <div class="experience-gallery">
            <figure><img src="/images/interior-pandora.webp" alt={t.experienceImageAlt} width="1350" height="2398" loading="lazy" /><figcaption><span>01</span>{t.caption1}</figcaption></figure>
            <figure><img src="/images/ritual-pandora.webp" alt={t.coffeeImageAlt} width="1350" height="2398" loading="lazy" /><figcaption><span>02</span>{t.caption2}</figcaption></figure>
            <figure><img src="/images/espacio-pandora.webp" alt={t.spaceImageAlt} width="1550" height="2693" loading="lazy" /><figcaption><span>03</span>{t.caption3}</figcaption></figure>
          </div>
          <div class="coffee-pair" aria-label={t.coffeeGalleryLabel}>
            <figure><img src="/images/cafe-vertido-pandora.webp" alt={t.coffeePourAlt} width="1920" height="1280" loading="lazy" /><figcaption>{t.coffeePourCaption}</figcaption></figure>
            <figure><img src="/images/cafe-servido-pandora.webp" alt={t.coffeeServeAlt} width="1920" height="1280" loading="lazy" /><figcaption>{t.coffeeServeCaption}</figcaption></figure>
          </div>
        </section>

        <section class="story" id="historia" aria-labelledby="story-title">
          <div class="section-wrap">
            <div class="section-label"><span>02 / 04</span><span>{t.storyEyebrow}</span></div>
            <div class="story-heading"><h2 id="story-title">{t.storyTitle1}<br /><em>{t.storyTitle2}</em></h2></div>
            <div class="story-grid">
              <figure class="story-art"><img src="/images/fabula-pandora.webp" alt={t.artworkAlt} width="1161" height="1020" loading="lazy" /><figcaption>{t.artworkCaption}</figcaption></figure>
              <div class="story-copy"><p>{t.storyText}</p><span class="story-signature">La Pandora <span aria-hidden="true">✳</span></span></div>
            </div>
            <div class="founders" aria-labelledby="founders-title">
              <figure class="founders-photo"><img src="/images/socios-consuelo-mario.webp" alt={t.foundersImageAlt} width="1920" height="1280" loading="lazy" /></figure>
              <div class="founders-copy">
                <p class="founders-eyebrow">{t.foundersEyebrow}</p>
                <h3 id="founders-title">{t.foundersTitle}</h3>
                <div class="founders-person"><strong>Mario Lozano</strong><span>{t.marioRole}</span></div>
                <div class="founders-person"><strong>Consuelo García</strong><span>{t.consueloRole}</span></div>
              </div>
            </div>
          </div>
        </section>

        <section class="origin" id="origen" aria-labelledby="origin-title">
          <div class="origin-copy"><div class="section-label"><span>03 / 04</span><span>{t.originEyebrow}</span></div><h2 id="origin-title">{t.originTitle}</h2><p>{t.originText}</p><span class="origin-note">{t.originNote}</span></div>
          <figure class="origin-visual"><img src="/images/empaque-pandora.webp" alt={t.originImageAlt} width="1200" height="1600" loading="lazy" /></figure>
        </section>

        <section class="visit section-wrap" id="visita" aria-labelledby="visit-title">
          <div class="section-label"><span>04 / 04</span><span>{t.visitEyebrow}</span></div>
          <div class="visit-head"><h2 id="visit-title">{t.visitTitle}</h2><p>{t.visitText}</p></div>
          <div class="visit-board"><div class="visit-detail"><span>{t.location}</span><p>{t.locationValue}</p></div><div class="visit-detail"><span>{t.hours}</span><p>{t.hours1}<br />{t.hours2}</p></div><div class="visit-actions"><a class="pill-link pill-dark" href={mapUrl} target="_blank" rel="noopener noreferrer">{t.maps}<span aria-hidden="true">↗</span></a><a class="under-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">{t.instagram}<span aria-hidden="true">↗</span></a></div></div>
          <div class="questions" aria-labelledby="questions-title"><h3 id="questions-title">{t.questionsTitle}</h3><div class="question-grid">{t.questions.map(({ question, answer }) => <article class="question"><h4>{question}</h4><p>{answer}</p></article>)}</div></div>
        </section>
      </main>

      <footer class="footer"><div class="footer-inner"><img src="/images/logo-oficial.jpg" alt="La Pandora Coffee" width="723" height="723" loading="lazy" /><p>{t.footerLine}</p><div class="footer-bottom"><span>© {new Date().getFullYear()} La Pandora Coffee. {t.rights}</span><span>Ciudad de Panamá, Panamá</span><span>{t.credit} <a href="https://lulabtech.com/">LulabTech</a></span><a class="back-to-top" href="#main" aria-label={topLabel}>↑</a></div></div></footer>
    </div>
  </body>
</html>
