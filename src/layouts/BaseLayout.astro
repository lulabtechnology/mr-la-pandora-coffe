---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import { content, locales, type Locale } from '../data/content';
import { absoluteUrl, businessSchema, homePaths, visitPaths } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  page?: 'home' | 'visit';
  questions?: readonly { question: string; answer: string }[];
}
const { locale, title, description, page = 'home', questions = [] } = Astro.props;
const t = content[locale];
const paths = page === 'home' ? homePaths : visitPaths;
const canonical = absoluteUrl(paths[locale]);
const socialImage = absoluteUrl('/images/social-preview.jpg');
const graph = [
  businessSchema(t.seoDescription),
  { '@type': 'WebSite', '@id': absoluteUrl('/#website'), url: absoluteUrl('/'), name: 'La Pandora Coffee', alternateName: 'La Pandora', publisher: { '@id': absoluteUrl('/#business') }, inLanguage: locales },
  {
    '@type': questions.length ? [page === 'visit' ? 'ContactPage' : 'WebPage', 'FAQPage'] : 'WebPage',
    '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: locale,
    isPartOf: { '@id': absoluteUrl('/#website') }, about: { '@id': absoluteUrl('/#business') },
    primaryImageOfPage: { '@type': 'ImageObject', url: socialImage, width: 1200, height: 630, caption: t.socialImageAlt },
    ...(page === 'visit' ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    ...(questions.length ? { mainEntity: questions.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) } : {}),
  },
  ...(page === 'visit' ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: absoluteUrl(homePaths[locale]) },
    { '@type': 'ListItem', position: 2, name: t.visitPage.nav, item: canonical },
  ] }] : []),
];
// Escape '<' so future text edits cannot terminate the JSON-LD script.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1512" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'es' ? 'es_PA' : locale === 'en' ? 'en_US' : 'ru_RU'} />
    {locales.filter((lang) => lang !== locale).map((lang) => <meta property="og:locale:alternate" content={lang === 'es' ? 'es_PA' : lang === 'en' ? 'en_US' : 'ru_RU'} />)}
    <meta property="og:site_name" content="La Pandora Coffee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={t.socialImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={t.socialImageAlt} />
    <link rel="canonical" href={canonical} />
    {locales.map((lang) => <link rel="alternate" hreflang={lang} href={absoluteUrl(paths[lang])} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(paths.es)} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    {locale !== 'ru' && <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque-latin-wght.woff2" crossorigin="anonymous" />}
    {page === 'home' && <>
      <link rel="preload" as="image" href="/images/optimized/hero-1440.webp" imagesrcset="/images/optimized/hero-960.webp 960w, /images/optimized/hero-1440.webp 1440w, /images/optimized/hero-1920.webp 1920w" imagesizes="100vw" media="(min-width: 761px)" />
      <link rel="preload" as="image" href="/images/optimized/taza-640.webp" imagesrcset="/images/optimized/taza-640.webp 640w, /images/optimized/taza-960.webp 960w" imagesizes="100vw" media="(max-width: 760px)" />
    </>}
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell"><slot /></div>
  </body>
</html>
